# 이 파일을 복사해서 같은 위치에 application-secret.yml 로 저장하고 실제 값을 채운다.
# application-secret.yml 은 .gitignore 에 등록되어 있어 커밋되지 않는다.
spring:
  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: 카카오_REST_API_키
            client-secret: 카카오_Client_Secret
          google:
            client-id: 구글_클라이언트_ID
            client-secret: 구글_클라이언트_보안_비밀번호
          naver:
            client-id: 네이버_클라이언트_ID
            client-secret: 네이버_클라이언트_시크릿

# sms 프로파일에서만 쓰인다. local 에서는 ConsoleSmsSender 가 뜨므로 비어 있어도 된다.
sms:
  infobip:
    base-url: https://xxxxx.api.infobip.com # 계정마다 다르다. 대시보드에서 확인
    api-key: Infobip_API_키
    sender: 발신자_ID # 체험 계정은 배정된 번호를 써야 한다. 임의 문자열은 거부되거나 무시된다
